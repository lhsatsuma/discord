{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "baseUrl": ".",
        "paths": {
            "#src/*": ["src/*"],
            "#commands/*": ["src/controllers/commands/*"],
            "#events*": ["src/controllers/events/*"],
            "#includes/*": ["src/includes/*"],
            "#models/*": ["src/models/*"],
            "#controllers/*": ["src/controllers/*"]
        }
    },
    "include": ["src/**/*.js", "run.js"]
}
