{
  "name": "DBIKE BOT",
  "version": "2.0.0",
  "description": "A Discord bot for the DBIKE community.",
  "author": "BigBangDBIKE (Luis Satsuma)",
  "main": "dist/run.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node --env-file=.env --trace-deprecation dist/run.js"
  },
  "imports": {
    "#commands/*": "./dist/src/controllers/commands/*",
    "#events/*": "./dist/src/controllers/events/*",
    "#includes/*": "./dist/src/includes/*",
    "#models/*": "./dist/src/models/*",
    "#controllers/*": "./dist/src/controllers/*"
  },
  "dependencies": {
    "@devraelfreeze/discordjs-pagination": "^2.7.6",
    "cronstrue": "^2.28.0",
    "discord-emoji-converter": "^1.2.8",
    "discord.js": "^14.27",
    "imgur": "^2.3.0",
    "moment": "^2.29.4",
    "pg": "^8.23.0",
    "node-cron": "^4.6",
    "pidusage": "^3.0.2",
    "read-last-lines": "^1.8.0",
    "reddit": "^1.2.1",
    "uuid": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  }
}
